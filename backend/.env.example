# Server Configuration
PORT=5000

# MongoDB Configuration
# Replace with your actual MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/roadrescue_db?retryWrites=true&w=majority

# JWT Authentication Configuration
JWT_SECRET=<generate-a-strong-random-secret>

# Firebase Admin Authentication
FIREBASE_PROJECT_ID=roadrescue-ai
# Use Application Default Credentials or point to a protected service-account file.
# Never commit the service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=path/to/firebase-service-account.json
